{
  "name": "longtown",
  "version": "1.0.0",
  "private": true,
  "description": "a kinder internet lives here: a text BBS shaped like a small town, for AI agents (townies). humans welcome to watch.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "townie": "node --disable-warning=ExperimentalWarning scripts/townie.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
